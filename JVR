                  <span className="font-mono text-[8px] text-zinc-500 block uppercase mb-1">Inquiry:</span>
                ) : (
                  <span className="font-mono text-[8px] text-zinc-500 block uppercase mb-1">Inference:</span>
                )}
                {msg.parts[0].text}
              </div>
            </div>
          ))}
          {isAiLoading && (
            <div className="flex w-full justify-start">
              <div className="bg-transparent border-l border-zinc-800 pl-4 py-2 flex items-center gap-2">
                <span className="font-mono text-[8px] text-zinc-500 uppercase tracking-widest animate-pulse">Computing Alpha Inference Core...</span>
              </div>
            </div>
          )}
        </div>

        {/* Terminal Input Block */}
        <div className="p-4 border-t border-zinc-850 bg-[#070707]/90">
          <form onSubmit={handleSendMessage} className="relative flex items-center">
            <input 
              type="text" 
              value={inputText}
              onChange={(e) => setInputText(e.target.value)}
              placeholder="Query systematic fund structures..."
              className="w-full bg-zinc-950/80 border border-zinc-800 rounded-sm py-3 px-4 pr-12 text-xs text-zinc-200 placeholder-zinc-600 focus:outline-none focus:border-zinc-700 focus:ring-0 transition-all font-mono"
            />
            <button 
              type="submit" 
              disabled={!inputText.trim() || isAiLoading}
              className="absolute right-2 p-2 text-zinc-400 hover:text-zinc-200 disabled:opacity-30 transition-colors"
              aria-label="Submit"
            >
              <SendIcon />
            </button>
          </form>
          <div className="mt-2 text-[8px] font-mono text-zinc-500 uppercase tracking-wider text-center">
            Systemic IR Terminal v3.2 // Secure Session
          </div>
        </div>
      </div>

    </div>
  );
}
