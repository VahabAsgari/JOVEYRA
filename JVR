      tick += 0.0015; // slightly faster animation
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      
      // Fine-grained mathematical coordinate lines
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.012)'; // brighter coordinate grid
      ctx.lineWidth = 1;
      
