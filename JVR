      for (let i = 0; i < waveCount; i++) {
        ctx.beginPath();
        const baseOffset = i * 45;
        for (let x = 0; x < canvas.width; x += 15) {
          const y = (canvas.height * 0.5) + 
                    Math.sin(x * 0.0015 + tick + i * 0.7) * 150 * Math.cos(tick * 0.1 + i * 0.2) +
                    Math.cos(x * 0.0008 - tick * 0.4) * 80;
          if (x === 0) {
            ctx.moveTo(x, y + baseOffset);
          } else {
            ctx.lineTo(x, y + baseOffset);
          }
        }
        ctx.stroke();
      }

